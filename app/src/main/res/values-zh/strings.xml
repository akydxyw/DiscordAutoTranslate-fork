    <string name="result_reason_config_invalid">配置无效。URL 使用 http:// 或 https:// 基础地址，例如 https://api.openai.com/v1，不要包含 /chat/completions、/responses 或 /messages。检查协议、模型、正整数超时和并发数，以及 Name: Value 格式的额外请求头。</string>
    <string name="result_reason_network_failure">网络连接失败。检查网络、DNS、TLS 证书及 VPN 或代理，再手动重试。</string>
    <string name="result_reason_request_timeout">连接或等待数据时超时。检查服务可用性并增大“超时（毫秒）”后重试；这不是模型异常停止或译文校验失败。</string>
    <string name="result_reason_http_parameters">服务拒绝请求参数（400）。检查模型、服务协议及流式支持；URL 填基础路径如 /v1，不包含协议端点。</string>
    <string name="result_reason_http_authentication">认证失败（401）。检查所选服务的 API 密钥及认证请求头。</string>
    <string name="result_reason_http_permission">无访问权限（403）。检查 API 密钥权限，以及账号是否可访问所选模型和服务。</string>
    <string name="result_reason_http_not_found">端点或模型不存在（404）。检查模型及协议；URL 仅填基础地址如 https://api.openai.com/v1，不包含 /chat/completions、/responses 或 /messages。</string>
    <string name="result_reason_http_server">服务返回服务器错误。检查供应商服务状态，稍后手动重试；修改译文校验不能修复服务异常。</string>
    <string name="result_reason_http_error">服务返回非成功 HTTP 状态。检查基础地址、协议、模型、密钥权限和供应商文档；不显示响应正文。</string>
    <string name="result_reason_rate_limited">服务已限流。稍后再试，降低“最大并发请求数”，并检查账号配额。</string>
    <string name="result_reason_response_invalid">响应与所选协议不匹配或格式无效。选择正确的服务协议及响应模式：流式须为 SSE，非流式须为 JSON。检查 URL 是否仅包含 /v1 等基础路径而非端点；仅 HTTP 200 不代表成功。</string>
    <string name="result_reason_response_incomplete">响应在协议完成前结束。检查服务或代理是否截断 JSON 或缺少 SSE 结束事件，并确认流式开关对应服务的 SSE/JSON 支持；不接受部分结果。</string>
    <string name="result_reason_generation_stopped">模型返回非正常完成原因，例如输出上限。检查模型限制，使用仅翻译的提示词并缩短输入；这不是网络超时，增大“超时（毫秒）”不能修复模型停止。拒绝或不支持的工具响应通常归为响应无效。</string>
    <string name="result_reason_translation_invalid">完整响应未通过文本防损坏校验，例如包装污染、旧分段或保留节点标记、模板占位符、长度比例异常。使用仅翻译的提示词及合适模型；增大超时不能修复内容损坏，不显示损坏译文。Discord 节点重建另行校验。</string>
    <string name="result_reason_empty_text">输入或提取的文本为空。输入非空测试文本；若已有输入，请检查模型、提示词及所选协议。</string>
    <string name="result_reason_cancelled">测试已取消。保持设置页打开，在准备好后重新发起测试。</string>
    <string name="result_reason_unknown_failure">发生意外失败。查看下方异常类型，保存启用项目日志的开关后再手动重试；日志不含异常消息或原始响应。</string>
</resources>
